# PHP / Composer
composer.phar
# seulement le vendor de Composer à la racine : public/assets/vendor/ (libs front) doit rester versionné
/vendor/
# composer.lock est versionné : installation reproductible (mêmes versions partout)

# Environment : secrets (mots de passe base, SMTP, clé Google, comptes DEMO_*) — jamais versionnés
.env
.env.*
!.env.example

# Sauvegardes et exports de base (peuvent contenir des données réelles)
backups/
*.sql.gz
*.dump
*.bak
*.old

# Runtime
storage/
public/uploads/
bootstrap/cache/
*.log

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Archives and binaries
*.phar
*.exe
*.tar
*.zip

# Tests and coverage
/tests/
phpunit.xml
coverage/
*.cov

# JavaScript dependencies/build
node_modules/
build/
dist/

# Scripts de test locaux (non versionnés)
scripts/simulate-registration.mjs
# mise à jour ponctuelle d'une base existante (le schéma de référence reste database/schema.sql)
scripts/update-menus.php
scripts/*.test.js
scripts/*.spec.js

# Maquettes : captures HTML intermédiaires (lourdes) et outils locaux ; PNG, PDF et maquettes.md sont versionnés
docs/maquettes/*.html
docs/maquettes/outils/

# Retours de test bruts (photos et captures privées)
feedback/
